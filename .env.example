# orbit-auth — copy to .env for local dev (chmod 600). Never commit .env.

DEPLOYMENT_ENVIRONMENT=dev
DATABASE_URL=postgres://auth:<password>@127.0.0.1:10000/auth?sslmode=disable
NOTIFICATIONS_GRPC_ADDR=localhost:10012
GRPC_PORT=10010
HEALTH_PORT=10011
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_ACTIVE_KEY_ID=orbit-dev-1
JWT_PUBLIC_KEYS_DIR=./secrets/jwt-public-keys
ORBIT_INTERNAL_TOKEN=
SENTRY_DSN=
TENANT_ID=
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:10022
# Apply embedded migrations on start; set false when a deploy runs `migrate` first.
MIGRATE_ON_START=true

# Add the org claim at login when the user has exactly one active membership.
AUTH_AUTO_SELECT_SINGLE_ORG=true

# Self-serve sign-up: open or off (default). off rejects the sign-up RPCs.
AUTH_SIGNUP=off

# Invite sign-up for phone invitations: on (default) or off/false. Independent of AUTH_SIGNUP.
AUTH_INVITE_SIGNUP=on

# Lifecycle events: Postgres outbox -> orbit-message-bus.
# inproc (default) relays and logs without subscribers; nats uses BUS_NATS_URL.
BUS_TRANSPORT=inproc
# BUS_NATS_URL=nats://localhost:10006

# Unleash Feature Flags
UNLEASH_URL=http://localhost:10026/api/
UNLEASH_API_TOKEN=default:development.unleash-insecure-api-token
UNLEASH_APP_NAME=orbit-auth

# Demo Seeding Mode (dev only)
DEMO_MODE=false
# AUTH_DEMO_USERS=[{"email":"demo@manova.space","password":"password123","display_name":"Demo User"}]
