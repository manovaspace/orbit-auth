# orbit-auth — copy to .env for local dev (chmod 600). Never commit .env.

DEPLOYMENT_ENVIRONMENT=dev
DATABASE_URL=postgres://orbit:orbit@localhost:10332/auth?sslmode=disable
NOTIFICATIONS_GRPC_ADDR=localhost:10110
GRPC_PORT=10100
HEALTH_PORT=10101
JWT_SECRET=
ORBIT_INTERNAL_TOKEN=
SENTRY_DSN=
TENANT_ID=
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:10517

# Unleash Feature Flags
UNLEASH_URL=http://localhost:10050/api/
UNLEASH_API_TOKEN=default:development.unleash-insecure-api-token
UNLEASH_APP_NAME=orbit-auth

# Demo Seeding Mode (dev only)
DEMO_MODE=false
# AUTH_DEMO_USERS=[{"email":"demo@manova.space","password":"password123","display_name":"Demo User"}]

